# ---------------------------------------------------------------------------
# ATS Resume Builder — server configuration. Copy to .env and fill in.
# Never commit .env or real API keys. Keys are only read by the server.
# ---------------------------------------------------------------------------

PORT=8787
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Leave empty for local SQLite (stored in DATA_DIR/resume-builder.db).
# Production on Vercel: DATABASE_URL=firestore (Cloud Firestore, uses the FIREBASE_* credentials below).
# For production use PostgreSQL, e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/ats_resume_builder
DATABASE_URL=
# PGSSL=true            # enable TLS for managed Postgres
# SQLite file + private original uploads
DATA_DIR=./data

# --- Firebase (sign-in + Firestore) -----------------------------------------
# Server (secret — Firebase console → Project settings → Service accounts → Generate new private key).
# Setting FIREBASE_PROJECT_ID turns on sign-in and makes it required (REQUIRE_AUTH=false keeps guest mode).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with 
 for line breaks, including the BEGIN/END lines.
FIREBASE_PRIVATE_KEY=
# REQUIRE_AUTH=true

# Browser (public identifiers — Project settings → General → Your apps → Web app config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Search engines ----------------------------------------------------------
# Public URL used for canonical links, robots.txt and sitemap.xml.
VITE_SITE_URL=https://resume-creator-ai.vercel.app
# Google Search Console → HTML tag verification → the content="…" value.
VITE_GOOGLE_SITE_VERIFICATION=

# --- Vercel ------------------------------------------------------------------
# Random secret; Vercel Cron sends it to /api/cron/cleanup (daily clean-up of expired guest sessions).
CRON_SECRET=

# --- Sessions & uploads -----------------------------------------------------
# sliding expiry; expired sessions and files are deleted hourly
SESSION_TTL_DAYS=30
# Vercel limits request bodies to 4.5 MB, so keep this at 4 there.
MAX_UPLOAD_MB=5

# --- AI providers -----------------------------------------------------------
# Providers are tried in this order; unconfigured ones are skipped, and if one
# fails or is rate-limited the next one is used automatically.
# With no keys at all the app still works using rule-based fallbacks.
AI_PROVIDER_ORDER=gemini,groq,mistral,anthropic
AI_TIMEOUT_MS=120000

# Google Gemini — free tier, best free option: reads PDFs natively and supports
# strict JSON schemas. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is busy ("high demand" on the free tier)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Groq — free tier, very fast. Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Mistral — free "Experiment" plan. Key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Claude (paid, optional). Put "anthropic" first in AI_PROVIDER_ORDER to prefer it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_FALLBACKS=false

# --- ATS scoring ------------------------------------------------------------
# Category weights (rescaled to total 100). Defaults shown.
# ATS_WEIGHTS={"keywords":30,"requiredSkills":25,"experience":20,"structure":15,"education":10}
# Blend an AI semantic-relevance estimate into the experience category (40%).
ATS_SEMANTIC_ANALYSIS=true

# --- Security / ops ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
# requests per window per IP
RATE_LIMIT_GENERAL=300
# AI/parsing requests per window per IP
RATE_LIMIT_AI=20
# set true behind a reverse proxy / load balancer
TRUST_PROXY=false
LOG_LEVEL=info
# LEGACY_API=false        # disable the classic editor's /api/agent endpoints
