# Resume Creator AI providers
# Keep real keys only in your local .env and never commit them.

# Gemini: primary document/PDF parser
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PARSER_MODEL=gemini-3.1-flash-lite

# Groq: primary resume analysis + JD tailoring
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Mistral: automatic fallback for analysis/tailoring and parser fallback
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

PORT=8787
